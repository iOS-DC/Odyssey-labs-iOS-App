<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="24128" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="24063"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="System colors in document resources" minToolsVersion="11.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--Ride Detail View Controller-->
        <scene sceneID="RD1-sc-001">
            <objects>
                <viewController storyboardIdentifier="RideDetailViewController" id="RD1-vc-001" customClass="RideDetailViewController" customModule="UniRide" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="RD1-vw-001">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <!-- Scroll View -->
                            <scrollView clipsSubviews="YES" multipleTouchEnabled="YES" contentMode="scaleToFill" alwaysBounceVertical="YES" translatesAutoresizingMaskIntoConstraints="NO" id="RD1-sv-001">
                                <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                                <subviews>
                                    <!-- Content Stack (map is first arranged subview, then cards added at runtime) -->
                                    <stackView opaque="NO" contentMode="scaleToFill" axis="vertical" spacing="16" translatesAutoresizingMaskIntoConstraints="NO" id="RD1-cs-001">
                                        <rect key="frame" x="0.0" y="0.0" width="393" height="220"/>
                                        <subviews>
                                            <!-- Map View (first arranged subview, height=220, full width) -->
                                            <mapView opaque="NO" contentMode="scaleToFill" mapType="standard" translatesAutoresizingMaskIntoConstraints="NO" id="RD1-mv-001" customClass="MKMapView" customModule="MapKit">
                                                <rect key="frame" x="0.0" y="0.0" width="393" height="220"/>
                                                <constraints>
                                                    <constraint firstAttribute="height" constant="220" id="RD1-ct-mv-h"/>
                                                </constraints>
                                            </mapView>
                                        </subviews>
                                    </stackView>
                                </subviews>
                                <constraints>
                                    <constraint firstItem="RD1-cs-001" firstAttribute="top" secondItem="RD1-sv-001" secondAttribute="top" id="RD1-ct-cs-top"/>
                                    <constraint firstItem="RD1-cs-001" firstAttribute="leading" secondItem="RD1-sv-001" secondAttribute="leading" id="RD1-ct-cs-lead"/>
                                    <constraint firstItem="RD1-cs-001" firstAttribute="trailing" secondItem="RD1-sv-001" secondAttribute="trailing" id="RD1-ct-cs-trail"/>
                                    <constraint firstItem="RD1-cs-001" firstAttribute="bottom" secondItem="RD1-sv-001" secondAttribute="bottom" id="RD1-ct-cs-bot"/>
                                    <constraint firstItem="RD1-cs-001" firstAttribute="width" secondItem="RD1-sv-001" secondAttribute="width" id="RD1-ct-cs-w"/>
                                </constraints>
                            </scrollView>
                            <!-- Bottom Bar (fixed, covers below safe area) -->
                            <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="RD1-bb-001">
                                <rect key="frame" x="0.0" y="768" width="393" height="84"/>
                                <color key="backgroundColor" systemColor="systemBackgroundColor"/>
                                <subviews>
                                    <!-- Request Button -->
                                    <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="RD1-rb-001">
                                        <rect key="frame" x="20" y="12" width="353" height="52"/>
                                        <state key="normal" title="Request to Join"/>
                                        <fontDescription key="fontDescription" type="system" pointSize="17" weight="semibold"/>
                                        <connections>
                                            <action selector="requestTapped" destination="RD1-vc-001" eventType="touchUpInside" id="RD1-ac-req"/>
                                        </connections>
                                    </button>
                                </subviews>
                                <constraints>
                                    <constraint firstItem="RD1-rb-001" firstAttribute="leading" secondItem="RD1-bb-001" secondAttribute="leading" constant="20" id="RD1-ct-rb-lead"/>
                                    <constraint firstItem="RD1-rb-001" firstAttribute="trailing" secondItem="RD1-bb-001" secondAttribute="trailing" constant="-20" id="RD1-ct-rb-trail"/>
                                    <constraint firstItem="RD1-rb-001" firstAttribute="height" constant="52" id="RD1-ct-rb-h"/>
                                    <constraint firstItem="RD1-rb-001" firstAttribute="top" secondItem="RD1-bb-001" secondAttribute="top" constant="12" id="RD1-ct-rb-top"/>
                                    <constraint firstAttribute="bottom" secondItem="RD1-rb-001" secondAttribute="bottom" constant="20" id="RD1-ct-rb-bot"/>
                                </constraints>
                            </view>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="RD1-sa-001"/>
                        <color key="backgroundColor" systemColor="systemGroupedBackgroundColor"/>
                        <constraints>
                            <!-- Scroll view -->
                            <constraint firstItem="RD1-sv-001" firstAttribute="top" secondItem="RD1-sa-001" secondAttribute="top" id="RD1-ct-sv-top"/>
                            <constraint firstItem="RD1-sv-001" firstAttribute="leading" secondItem="RD1-vw-001" secondAttribute="leading" id="RD1-ct-sv-lead"/>
                            <constraint firstItem="RD1-sv-001" firstAttribute="trailing" secondItem="RD1-vw-001" secondAttribute="trailing" id="RD1-ct-sv-trail"/>
                            <constraint firstItem="RD1-sv-001" firstAttribute="bottom" secondItem="RD1-bb-001" secondAttribute="top" id="RD1-ct-sv-bot"/>
                            <!-- Bottom bar -->
                            <constraint firstItem="RD1-bb-001" firstAttribute="leading" secondItem="RD1-vw-001" secondAttribute="leading" id="RD1-ct-bb-lead"/>
                            <constraint firstItem="RD1-bb-001" firstAttribute="trailing" secondItem="RD1-vw-001" secondAttribute="trailing" id="RD1-ct-bb-trail"/>
                            <constraint firstItem="RD1-bb-001" firstAttribute="bottom" secondItem="RD1-vw-001" secondAttribute="bottom" id="RD1-ct-bb-bot"/>
                            <constraint firstItem="RD1-bb-001" firstAttribute="height" constant="84" id="RD1-ct-bb-h"/>
                        </constraints>
                    </view>
                    <navigationItem key="navigationItem" title="Ride Details" largeTitleDisplayMode="never" id="RD1-ni-001"/>
                    <connections>
                        <outlet property="scrollView" destination="RD1-sv-001" id="RD1-ol-sv"/>
                        <outlet property="contentStack" destination="RD1-cs-001" id="RD1-ol-cs"/>
                        <outlet property="mapView" destination="RD1-mv-001" id="RD1-ol-mv"/>
                        <outlet property="bottomBar" destination="RD1-bb-001" id="RD1-ol-bb"/>
                        <outlet property="requestBtn" destination="RD1-rb-001" id="RD1-ol-rb"/>
                    </connections>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="RD1-fr-001" userLabel="First Responder" customClass="UIResponder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="0.0" y="0.0"/>
        </scene>
    </scenes>
    <resources>
        <systemColor name="systemGroupedBackgroundColor">
            <color red="0.94901960780000005" green="0.94901960780000005" blue="0.96862745100000003" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
        </systemColor>
        <systemColor name="systemBackgroundColor">
            <color white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
        </systemColor>
    </resources>
</document>
