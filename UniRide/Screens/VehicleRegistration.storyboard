                                <subviews>
                                    <!-- Form Stack -->
                                    <stackView opaque="NO" contentMode="scaleToFill" axis="vertical" spacing="20" translatesAutoresizingMaskIntoConstraints="NO" id="VR1-fs-001">
                                        <rect key="frame" x="16" y="24" width="329" height="0"/>
                                    </stackView>
                                </subviews>
