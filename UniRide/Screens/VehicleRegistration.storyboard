                                    <constraint firstAttribute="trailing" secondItem="VR1-fs-001" secondAttribute="trailing" constant="16" id="VR1-ct-fs-trail"/>
                                    <constraint firstAttribute="bottom" secondItem="VR1-fs-001" secondAttribute="bottom" constant="32" id="VR1-ct-fs-bot"/>
