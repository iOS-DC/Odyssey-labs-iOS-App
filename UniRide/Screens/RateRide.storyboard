<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="24128" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="24063"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="System colors in document resources" minToolsVersion="11.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--Rate Ride View Controller-->
        <scene sceneID="RR1-sc-001">
            <objects>
                <viewController storyboardIdentifier="RateRideViewController" id="RR1-vc-001" customClass="RateRideViewController" customModule="UniRide" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="RR1-vw-001">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="500"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <!-- Avatar -->
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFill" horizontalHuggingPriority="251" verticalHuggingPriority="251" translatesAutoresizingMaskIntoConstraints="NO" id="RR1-av-001">
                                <rect key="frame" x="161" y="28" width="70" height="70"/>
                                <color key="backgroundColor" systemColor="systemGray5Color"/>
                            </imageView>
                            <!-- Name Label -->
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" textAlignment="center" lineBreakMode="middleTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="RR1-nl-001">
                                <rect key="frame" x="24" y="110" width="345" height="21"/>
                                <fontDescription key="fontDescription" type="system" pointSize="17" weight="semibold"/>
                                <nil key="textColor"/>
                                <nil key="highlightedColor"/>
                            </label>
                            <!-- Prompt Label -->
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="How was your ride?" textAlignment="center" lineBreakMode="middleTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="RR1-pl-001">
                                <rect key="frame" x="24" y="135" width="345" height="18"/>
                                <fontDescription key="fontDescription" type="system" pointSize="15" weight="medium"/>
                                <color key="textColor" systemColor="secondaryLabelColor"/>
                                <nil key="highlightedColor"/>
                            </label>
                            <!-- Star Stack (5 buttons) -->
                            <stackView opaque="NO" contentMode="scaleToFill" axis="horizontal" spacing="10" alignment="center" translatesAutoresizingMaskIntoConstraints="NO" id="RR1-ss-001">
                                <rect key="frame" x="97" y="167" width="200" height="44"/>
                                <subviews>
                                    <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" tag="1" translatesAutoresizingMaskIntoConstraints="NO" id="RR1-s1-001">
                                        <rect key="frame" x="0.0" y="0.0" width="44" height="44"/>
                                        <image key="image" systemName="star"/>
                                        <color key="tintColor" systemColor="systemGray3Color"/>
                                        <constraints>
                                            <constraint firstAttribute="width" constant="44" id="RR1-s1-w"/>
                                            <constraint firstAttribute="height" constant="44" id="RR1-s1-h"/>
                                        </constraints>
                                        <connections>
                                            <action selector="starTapped:" destination="RR1-vc-001" eventType="touchUpInside" id="RR1-ac-s1"/>
                                        </connections>
                                    </button>
                                    <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" tag="2" translatesAutoresizingMaskIntoConstraints="NO" id="RR1-s2-001">
                                        <rect key="frame" x="54" y="0.0" width="44" height="44"/>
                                        <image key="image" systemName="star"/>
                                        <color key="tintColor" systemColor="systemGray3Color"/>
                                        <constraints>
                                            <constraint firstAttribute="width" constant="44" id="RR1-s2-w"/>
                                            <constraint firstAttribute="height" constant="44" id="RR1-s2-h"/>
                                        </constraints>
                                        <connections>
                                            <action selector="starTapped:" destination="RR1-vc-001" eventType="touchUpInside" id="RR1-ac-s2"/>
                                        </connections>
                                    </button>
                                    <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" tag="3" translatesAutoresizingMaskIntoConstraints="NO" id="RR1-s3-001">
                                        <rect key="frame" x="108" y="0.0" width="44" height="44"/>
                                        <image key="image" systemName="star"/>
                                        <color key="tintColor" systemColor="systemGray3Color"/>
                                        <constraints>
                                            <constraint firstAttribute="width" constant="44" id="RR1-s3-w"/>
                                            <constraint firstAttribute="height" constant="44" id="RR1-s3-h"/>
                                        </constraints>
                                        <connections>
                                            <action selector="starTapped:" destination="RR1-vc-001" eventType="touchUpInside" id="RR1-ac-s3"/>
                                        </connections>
                                    </button>
                                    <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" tag="4" translatesAutoresizingMaskIntoConstraints="NO" id="RR1-s4-001">
                                        <rect key="frame" x="162" y="0.0" width="44" height="44"/>
                                        <image key="image" systemName="star"/>
                                        <color key="tintColor" systemColor="systemGray3Color"/>
                                        <constraints>
                                            <constraint firstAttribute="width" constant="44" id="RR1-s4-w"/>
                                            <constraint firstAttribute="height" constant="44" id="RR1-s4-h"/>
                                        </constraints>
                                        <connections>
                                            <action selector="starTapped:" destination="RR1-vc-001" eventType="touchUpInside" id="RR1-ac-s4"/>
                                        </connections>
                                    </button>
                                    <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" tag="5" translatesAutoresizingMaskIntoConstraints="NO" id="RR1-s5-001">
                                        <rect key="frame" x="216" y="0.0" width="44" height="44"/>
                                        <image key="image" systemName="star"/>
                                        <color key="tintColor" systemColor="systemGray3Color"/>
                                        <constraints>
                                            <constraint firstAttribute="width" constant="44" id="RR1-s5-w"/>
                                            <constraint firstAttribute="height" constant="44" id="RR1-s5-h"/>
                                        </constraints>
                                        <connections>
                                            <action selector="starTapped:" destination="RR1-vc-001" eventType="touchUpInside" id="RR1-ac-s5"/>
                                        </connections>
                                    </button>
                                </subviews>
                            </stackView>
                            <!-- Comment Text View -->
                            <textView clipsSubviews="YES" contentMode="scaleToFill" text="Add a comment (optional)..." textAlignment="natural" lineBreakMode="wordWrap" returnKeyType="default" translatesAutoresizingMaskIntoConstraints="NO" id="RR1-tv-001">
                                <rect key="frame" x="24" y="227" width="345" height="72"/>
                                <fontDescription key="fontDescription" type="system" pointSize="15" weight="medium"/>
                                <color key="backgroundColor" systemColor="secondarySystemBackgroundColor"/>
                                <color key="textColor" systemColor="tertiaryLabelColor"/>
                            </textView>
                            <!-- Submit Button -->
                            <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="RR1-sb-001">
                                <rect key="frame" x="24" y="315" width="345" height="50"/>
                                <fontDescription key="fontDescription" type="system" pointSize="17" weight="semibold"/>
                                <color key="tintColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                                <connections>
                                    <action selector="submitTapped" destination="RR1-vc-001" eventType="touchUpInside" id="RR1-ac-sub"/>
                                </connections>
                            </button>
                            <!-- Skip Button -->
                            <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="RR1-skip-001">
                                <rect key="frame" x="152" y="373" width="89" height="21"/>
                                <state key="normal" title="Skip"/>
                                <fontDescription key="fontDescription" type="system" pointSize="15" weight="medium"/>
                                <color key="tintColor" systemColor="tertiaryLabelColor"/>
                                <connections>
                                    <action selector="skipTapped" destination="RR1-vc-001" eventType="touchUpInside" id="RR1-ac-skip"/>
                                </connections>
                            </button>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="RR1-sa-001"/>
                        <color key="backgroundColor" systemColor="systemBackgroundColor"/>
                        <constraints>
                            <!-- Avatar -->
                            <constraint firstItem="RR1-av-001" firstAttribute="top" secondItem="RR1-vw-001" secondAttribute="top" constant="28" id="RR1-ct-av-top"/>
                            <constraint firstItem="RR1-av-001" firstAttribute="centerX" secondItem="RR1-vw-001" secondAttribute="centerX" id="RR1-ct-av-cx"/>
                            <constraint firstItem="RR1-av-001" firstAttribute="width" constant="70" id="RR1-ct-av-w"/>
                            <constraint firstItem="RR1-av-001" firstAttribute="height" constant="70" id="RR1-ct-av-h"/>
                            <!-- Name Label -->
                            <constraint firstItem="RR1-nl-001" firstAttribute="top" secondItem="RR1-av-001" secondAttribute="bottom" constant="12" id="RR1-ct-nl-top"/>
                            <constraint firstItem="RR1-nl-001" firstAttribute="leading" secondItem="RR1-vw-001" secondAttribute="leading" constant="24" id="RR1-ct-nl-lead"/>
                            <constraint firstItem="RR1-nl-001" firstAttribute="trailing" secondItem="RR1-vw-001" secondAttribute="trailing" constant="-24" id="RR1-ct-nl-trail"/>
                            <!-- Prompt Label -->
                            <constraint firstItem="RR1-pl-001" firstAttribute="top" secondItem="RR1-nl-001" secondAttribute="bottom" constant="4" id="RR1-ct-pl-top"/>
                            <constraint firstItem="RR1-pl-001" firstAttribute="leading" secondItem="RR1-nl-001" secondAttribute="leading" id="RR1-ct-pl-lead"/>
                            <constraint firstItem="RR1-pl-001" firstAttribute="trailing" secondItem="RR1-nl-001" secondAttribute="trailing" id="RR1-ct-pl-trail"/>
                            <!-- Star Stack -->
                            <constraint firstItem="RR1-ss-001" firstAttribute="top" secondItem="RR1-pl-001" secondAttribute="bottom" constant="16" id="RR1-ct-ss-top"/>
                            <constraint firstItem="RR1-ss-001" firstAttribute="centerX" secondItem="RR1-vw-001" secondAttribute="centerX" id="RR1-ct-ss-cx"/>
                            <!-- Comment Text View -->
                            <constraint firstItem="RR1-tv-001" firstAttribute="top" secondItem="RR1-ss-001" secondAttribute="bottom" constant="16" id="RR1-ct-tv-top"/>
                            <constraint firstItem="RR1-tv-001" firstAttribute="leading" secondItem="RR1-vw-001" secondAttribute="leading" constant="24" id="RR1-ct-tv-lead"/>
                            <constraint firstItem="RR1-tv-001" firstAttribute="trailing" secondItem="RR1-vw-001" secondAttribute="trailing" constant="-24" id="RR1-ct-tv-trail"/>
                            <constraint firstItem="RR1-tv-001" firstAttribute="height" constant="72" id="RR1-ct-tv-h"/>
                            <!-- Submit Button -->
                            <constraint firstItem="RR1-sb-001" firstAttribute="top" secondItem="RR1-tv-001" secondAttribute="bottom" constant="16" id="RR1-ct-sb-top"/>
                            <constraint firstItem="RR1-sb-001" firstAttribute="leading" secondItem="RR1-vw-001" secondAttribute="leading" constant="24" id="RR1-ct-sb-lead"/>
                            <constraint firstItem="RR1-sb-001" firstAttribute="trailing" secondItem="RR1-vw-001" secondAttribute="trailing" constant="-24" id="RR1-ct-sb-trail"/>
                            <constraint firstItem="RR1-sb-001" firstAttribute="height" constant="50" id="RR1-ct-sb-h"/>
                            <!-- Skip Button -->
                            <constraint firstItem="RR1-skip-001" firstAttribute="top" secondItem="RR1-sb-001" secondAttribute="bottom" constant="8" id="RR1-ct-skip-top"/>
                            <constraint firstItem="RR1-skip-001" firstAttribute="centerX" secondItem="RR1-vw-001" secondAttribute="centerX" id="RR1-ct-skip-cx"/>
                        </constraints>
                    </view>
                    <connections>
                        <outlet property="avatarView" destination="RR1-av-001" id="RR1-ol-av"/>
                        <outlet property="nameLabel" destination="RR1-nl-001" id="RR1-ol-nl"/>
                        <outlet property="promptLabel" destination="RR1-pl-001" id="RR1-ol-pl"/>
                        <outlet property="commentView" destination="RR1-tv-001" id="RR1-ol-cv"/>
                        <outlet property="submitBtn" destination="RR1-sb-001" id="RR1-ol-sb"/>
                        <outlet property="skipBtn" destination="RR1-skip-001" id="RR1-ol-skip"/>
                        <outlet property="starButton1" destination="RR1-s1-001" id="RR1-ol-s1"/>
                        <outlet property="starButton2" destination="RR1-s2-001" id="RR1-ol-s2"/>
                        <outlet property="starButton3" destination="RR1-s3-001" id="RR1-ol-s3"/>
                        <outlet property="starButton4" destination="RR1-s4-001" id="RR1-ol-s4"/>
                        <outlet property="starButton5" destination="RR1-s5-001" id="RR1-ol-s5"/>
                    </connections>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="RR1-fr-001" userLabel="First Responder" customClass="UIResponder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="0.0" y="0.0"/>
        </scene>
    </scenes>
    <resources>
        <systemColor name="systemBackgroundColor">
            <color white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
        </systemColor>
        <systemColor name="secondarySystemBackgroundColor">
            <color red="0.94117647058823528" green="0.94117647058823528" blue="0.96078431372549022" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
        </systemColor>
        <systemColor name="secondaryLabelColor">
            <color red="0.23529411764705882" green="0.23529411764705882" blue="0.26274509803921570" alpha="0.59999999999999998" colorSpace="custom" customColorSpace="sRGB"/>
        </systemColor>
        <systemColor name="systemGray3Color">
            <color red="0.78039215686274510" green="0.78039215686274510" blue="0.80000000000000004" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
        </systemColor>
        <systemColor name="systemGray5Color">
            <color red="0.89803921568627450" green="0.89803921568627450" blue="0.91764705882352940" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
        </systemColor>
        <systemColor name="tertiaryLabelColor">
            <color red="0.23529411764705882" green="0.23529411764705882" blue="0.26274509803921570" alpha="0.29999999999999999" colorSpace="custom" customColorSpace="sRGB"/>
        </systemColor>
    </resources>
</document>
