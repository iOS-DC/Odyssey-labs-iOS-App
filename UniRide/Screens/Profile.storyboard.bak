<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="24128" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="UCs-bb-Yik">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="24063"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="System colors in document resources" minToolsVersion="11.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--ProfileViewController-->
        <scene sceneID="s0d-6b-0kx">
            <objects>
                <viewController storyboardIdentifier="ProfileViewController" id="Y6W-OH-hqX" customClass="ProfileViewController" customModule="UniRide" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="5EZ-qb-Rvc">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>

                            <!-- ═══════════════════════════════════════════════
                                 HERO CARD
                                 Held off-screen in the view hierarchy.
                                 ProfileViewController pulls it via @IBOutlet
                                 and adds it to the programmatic contentStack.
                            ════════════════════════════════════════════════ -->
                            <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="hcd-01-vw">
                                <rect key="frame" x="-1000" y="0.0" width="345" height="10"/>
                                <subviews>
                                    <!-- Inner vertical stack -->
                                    <stackView axis="vertical" spacing="6" alignment="center" translatesAutoresizingMaskIntoConstraints="NO" id="hsi-01-stk">
                                        <subviews>

                                            <!-- Avatar -->
                                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFill" image="person.crop.circle.fill" catalog="system" translatesAutoresizingMaskIntoConstraints="NO" id="avi-01-img">
                                                <color key="tintColor" red="0.102" green="0.435" blue="0.855" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                                <constraints>
                                                    <constraint firstAttribute="width"  constant="88" id="aviw-01"/>
                                                    <constraint firstAttribute="height" constant="88" id="avih-01"/>
                                                </constraints>
                                            </imageView>

                                            <!-- Name -->
                                            <label text="Your Name" textAlignment="center" translatesAutoresizingMaskIntoConstraints="NO" id="nml-01-lbl">
                                                <fontDescription key="fontDescription" type="system" pointSize="22" weight="bold"/>
                                                <nil key="textColor"/>
                                                <nil key="highlightedColor"/>
                                            </label>

                                            <!-- Subtitle (dept / year) -->
                                            <label text="—" textAlignment="center" translatesAutoresizingMaskIntoConstraints="NO" id="sbl-01-lbl">
                                                <fontDescription key="fontDescription" type="system" pointSize="15" weight="medium"/>
                                                <color key="textColor" cocoaTouchSystemColor="secondaryLabelColor"/>
                                                <nil key="highlightedColor"/>
                                            </label>

                                            <!-- Member since -->
                                            <label text="Member Since 2025" textAlignment="center" translatesAutoresizingMaskIntoConstraints="NO" id="mbl-01-lbl">
                                                <fontDescription key="fontDescription" type="system" pointSize="13" weight="regular"/>
                                                <color key="textColor" cocoaTouchSystemColor="tertiaryLabelColor"/>
                                                <nil key="highlightedColor"/>
                                            </label>

                                            <!-- Divider -->
                                            <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="dvd-01-vw">
                                                <color key="backgroundColor" systemColor="systemGray5Color"/>
                                                <constraints>
                                                    <constraint firstAttribute="height" constant="1" id="dvdh-01"/>
                                                </constraints>
                                            </view>

                                            <!-- Stats row -->
                                            <stackView axis="horizontal" distribution="fillEqually" alignment="center" spacing="0" translatesAutoresizingMaskIntoConstraints="NO" id="sts-01-stk">
                                                <!-- Rating column -->
                                                <subviews>
                                                    <stackView axis="vertical" spacing="2" alignment="center" translatesAutoresizingMaskIntoConstraints="NO" id="rtc-01-stk">
                                                        <subviews>
                                                            <label text="—" textAlignment="center" translatesAutoresizingMaskIntoConstraints="NO" id="rtv-01-lbl">
                                                                <fontDescription key="fontDescription" type="system" pointSize="17" weight="semibold"/>
                                                                <nil key="textColor"/>
                                                                <nil key="highlightedColor"/>
                                                            </label>
                                                            <label text="Rating" textAlignment="center" translatesAutoresizingMaskIntoConstraints="NO" id="rtt-01-lbl">
                                                                <fontDescription key="fontDescription" type="system" pointSize="13" weight="regular"/>
                                                                <color key="textColor" cocoaTouchSystemColor="secondaryLabelColor"/>
                                                                <nil key="highlightedColor"/>
                                                            </label>
                                                        </subviews>
                                                    </stackView>
                                                    <!-- Separator -->
                                                    <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="vsp-01-vw">
                                                        <color key="backgroundColor" systemColor="systemGray5Color"/>
                                                        <constraints>
                                                            <constraint firstAttribute="width"  constant="1"  id="vspw-01"/>
                                                            <constraint firstAttribute="height" constant="36" id="vsph-01"/>
                                                        </constraints>
                                                    </view>
                                                    <!-- Rides column -->
                                                    <stackView axis="vertical" spacing="2" alignment="center" translatesAutoresizingMaskIntoConstraints="NO" id="rdc-01-stk">
                                                        <subviews>
                                                            <label text="0" textAlignment="center" translatesAutoresizingMaskIntoConstraints="NO" id="rdv-01-lbl">
                                                                <fontDescription key="fontDescription" type="system" pointSize="17" weight="semibold"/>
                                                                <nil key="textColor"/>
                                                                <nil key="highlightedColor"/>
                                                            </label>
                                                            <label text="Rides" textAlignment="center" translatesAutoresizingMaskIntoConstraints="NO" id="rdt-01-lbl">
                                                                <fontDescription key="fontDescription" type="system" pointSize="13" weight="regular"/>
                                                                <color key="textColor" cocoaTouchSystemColor="secondaryLabelColor"/>
                                                                <nil key="highlightedColor"/>
                                                            </label>
                                                        </subviews>
                                                    </stackView>
                                                </subviews>
                                            </stackView>

                                        </subviews>
                                        <!-- Custom spacing: extra gap before divider and after -->
                                        <customSpacings>
                                            <customSpacing afterIndex="3" value="16"/>
                                            <customSpacing afterIndex="4" value="12"/>
                                        </customSpacings>
                                    </stackView>
                                </subviews>
                                <!-- Inner stack pinned 24/20 from card edges -->
                                <constraints>
                                    <constraint firstItem="hsi-01-stk" firstAttribute="top"      secondItem="hcd-01-vw" secondAttribute="top"      constant="24" id="hct-01"/>
                                    <constraint firstItem="hsi-01-stk" firstAttribute="leading"   secondItem="hcd-01-vw" secondAttribute="leading"   constant="20" id="hcl-01"/>
                                    <constraint firstItem="hcd-01-vw"  firstAttribute="trailing"  secondItem="hsi-01-stk" secondAttribute="trailing"  constant="20" id="hcr-01"/>
                                    <constraint firstItem="hcd-01-vw"  firstAttribute="bottom"    secondItem="hsi-01-stk" secondAttribute="bottom"    constant="20" id="hcb-01"/>
                                    <!-- Divider stretches full width of inner stack -->
                                    <constraint firstItem="dvd-01-vw" firstAttribute="width" secondItem="hsi-01-stk" secondAttribute="width" id="dvdw-01"/>
                                    <!-- Stats row stretches full width -->
                                    <constraint firstItem="sts-01-stk" firstAttribute="width" secondItem="hsi-01-stk" secondAttribute="width" id="stsw-01"/>
                                </constraints>
                                <color key="backgroundColor" systemColor="systemBackgroundColor"/>
                            </view>

                            <!-- ═══════════════════════════════════════════════
                                 CONTACT CARD
                            ════════════════════════════════════════════════ -->
                            <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="ccd-01-vw">
                                <rect key="frame" x="-1000" y="0.0" width="345" height="10"/>
                                <subviews>
                                    <stackView axis="vertical" spacing="12" translatesAutoresizingMaskIntoConstraints="NO" id="cms-01-stk">
                                        <subviews>

                                            <!-- Section title -->
                                            <label text="Contact Information" translatesAutoresizingMaskIntoConstraints="NO" id="ctt-01-lbl">
                                                <fontDescription key="fontDescription" type="system" pointSize="17" weight="semibold"/>
                                                <nil key="textColor"/>
                                                <nil key="highlightedColor"/>
                                            </label>

                                            <!-- Sep 1 -->
                                            <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="cs1-01-vw">
                                                <color key="backgroundColor" systemColor="systemGray4Color"/>
                                                <constraints><constraint firstAttribute="height" constant="1" id="cs1h-01"/></constraints>
                                            </view>

                                            <!-- Email row -->
                                            <stackView axis="horizontal" spacing="10" alignment="center" translatesAutoresizingMaskIntoConstraints="NO" id="emr-01-stk">
                                                <subviews>
                                                    <imageView image="envelope.fill" catalog="system" contentMode="scaleAspectFit" translatesAutoresizingMaskIntoConstraints="NO" id="emi-01-img">
                                                        <color key="tintColor" red="0.102" green="0.435" blue="0.855" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                                        <constraints>
                                                            <constraint firstAttribute="width"  constant="20" id="emiw-01"/>
                                                            <constraint firstAttribute="height" constant="20" id="emih-01"/>
                                                        </constraints>
                                                    </imageView>
                                                    <stackView axis="vertical" spacing="2" translatesAutoresizingMaskIntoConstraints="NO" id="emt-01-stk">
                                                        <subviews>
                                                            <label text="Email" translatesAutoresizingMaskIntoConstraints="NO" id="emc-01-lbl">
                                                                <fontDescription key="fontDescription" type="system" pointSize="13" weight="regular"/>
                                                                <color key="textColor" cocoaTouchSystemColor="secondaryLabelColor"/>
                                                                <nil key="highlightedColor"/>
                                                            </label>
                                                            <label text="—" numberOfLines="0" translatesAutoresizingMaskIntoConstraints="NO" id="emv-01-lbl">
                                                                <fontDescription key="fontDescription" type="system" pointSize="15" weight="medium"/>
                                                                <nil key="textColor"/>
                                                                <nil key="highlightedColor"/>
                                                            </label>
                                                        </subviews>
                                                    </stackView>
                                                </subviews>
                                            </stackView>

                                            <!-- Sep 2 -->
                                            <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="cs2-01-vw">
                                                <color key="backgroundColor" systemColor="systemGray4Color"/>
                                                <constraints><constraint firstAttribute="height" constant="1" id="cs2h-01"/></constraints>
                                            </view>

                                            <!-- Phone row -->
                                            <stackView axis="horizontal" spacing="10" alignment="center" translatesAutoresizingMaskIntoConstraints="NO" id="phr-01-stk">
                                                <subviews>
                                                    <imageView image="phone.fill" catalog="system" contentMode="scaleAspectFit" translatesAutoresizingMaskIntoConstraints="NO" id="phi-01-img">
                                                        <color key="tintColor" red="0.102" green="0.435" blue="0.855" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                                        <constraints>
                                                            <constraint firstAttribute="width"  constant="20" id="phiw-01"/>
                                                            <constraint firstAttribute="height" constant="20" id="phih-01"/>
                                                        </constraints>
                                                    </imageView>
                                                    <stackView axis="vertical" spacing="2" translatesAutoresizingMaskIntoConstraints="NO" id="pht-01-stk">
                                                        <subviews>
                                                            <label text="Phone" translatesAutoresizingMaskIntoConstraints="NO" id="phc-01-lbl">
                                                                <fontDescription key="fontDescription" type="system" pointSize="13" weight="regular"/>
                                                                <color key="textColor" cocoaTouchSystemColor="secondaryLabelColor"/>
                                                                <nil key="highlightedColor"/>
                                                            </label>
                                                            <label text="—" translatesAutoresizingMaskIntoConstraints="NO" id="phv-01-lbl">
                                                                <fontDescription key="fontDescription" type="system" pointSize="15" weight="medium"/>
                                                                <nil key="textColor"/>
                                                                <nil key="highlightedColor"/>
                                                            </label>
                                                        </subviews>
                                                    </stackView>
                                                </subviews>
                                            </stackView>

                                            <!-- Sep 3 -->
                                            <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="cs3-01-vw">
                                                <color key="backgroundColor" systemColor="systemGray4Color"/>
                                                <constraints><constraint firstAttribute="height" constant="1" id="cs3h-01"/></constraints>
                                            </view>

                                            <!-- Home row -->
                                            <stackView axis="horizontal" spacing="10" alignment="center" translatesAutoresizingMaskIntoConstraints="NO" id="hmr-01-stk">
                                                <subviews>
                                                    <imageView image="house.fill" catalog="system" contentMode="scaleAspectFit" translatesAutoresizingMaskIntoConstraints="NO" id="hmi-01-img">
                                                        <color key="tintColor" red="0.102" green="0.435" blue="0.855" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                                        <constraints>
                                                            <constraint firstAttribute="width"  constant="20" id="hmiw-01"/>
                                                            <constraint firstAttribute="height" constant="20" id="hmih-01"/>
                                                        </constraints>
                                                    </imageView>
                                                    <stackView axis="vertical" spacing="2" translatesAutoresizingMaskIntoConstraints="NO" id="hmt-01-stk">
                                                        <subviews>
                                                            <label text="Home Location" translatesAutoresizingMaskIntoConstraints="NO" id="hmc-01-lbl">
                                                                <fontDescription key="fontDescription" type="system" pointSize="13" weight="regular"/>
                                                                <color key="textColor" cocoaTouchSystemColor="secondaryLabelColor"/>
                                                                <nil key="highlightedColor"/>
                                                            </label>
                                                            <label text="Tap Edit to set home" numberOfLines="0" translatesAutoresizingMaskIntoConstraints="NO" id="hmv-01-lbl">
                                                                <fontDescription key="fontDescription" type="system" pointSize="15" weight="medium"/>
                                                                <nil key="textColor"/>
                                                                <nil key="highlightedColor"/>
                                                            </label>
                                                        </subviews>
                                                    </stackView>
                                                    <!-- Edit home button -->
                                                    <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="heb-01-btn">
                                                        <fontDescription key="fontDescription" type="system" pointSize="17" weight="semibold"/>
                                                        <state key="normal" title="Edit"/>
                                                        <connections>
                                                            <action selector="editHomeLocationTapped" destination="Y6W-OH-hqX" eventType="touchUpInside" id="heb-act-01"/>
                                                        </connections>
                                                    </button>
                                                </subviews>
                                            </stackView>

                                        </subviews>
                                    </stackView>
                                </subviews>
                                <!-- Inner stack pinned 20/16 from card edges -->
                                <constraints>
                                    <constraint firstItem="cms-01-stk" firstAttribute="top"     secondItem="ccd-01-vw" secondAttribute="top"     constant="20" id="cct-01"/>
                                    <constraint firstItem="cms-01-stk" firstAttribute="leading"  secondItem="ccd-01-vw" secondAttribute="leading"  constant="16" id="ccl-01"/>
                                    <constraint firstItem="ccd-01-vw"  firstAttribute="trailing" secondItem="cms-01-stk" secondAttribute="trailing" constant="16" id="ccr-01"/>
                                    <constraint firstItem="ccd-01-vw"  firstAttribute="bottom"   secondItem="cms-01-stk" secondAttribute="bottom"   constant="20" id="ccb-01"/>
                                </constraints>
                                <color key="backgroundColor" systemColor="systemBackgroundColor"/>
                            </view>

                        </subviews>
                        <viewLayoutGuide key="safeArea" id="vDu-zF-Fre"/>
                        <color key="backgroundColor" systemColor="systemGroupedBackgroundColor"/>
                    </view>
                    <navigationItem key="navigationItem" title="Profile" id="OvI-cT-WiC"/>
                    <simulatedToolbarMetrics key="simulatedBottomBarMetrics"/>
                    <connections>
                        <!-- Card outlets — controller lifts these into the programmatic contentStack -->
                        <outlet property="heroCard"         destination="hcd-01-vw"  id="out-hcd-01"/>
                        <outlet property="contactCard"      destination="ccd-01-vw"  id="out-ccd-01"/>
                        <!-- Label outlets inside hero card -->
                        <outlet property="avatarImageView"  destination="avi-01-img" id="out-avi-01"/>
                        <outlet property="nameLabel"        destination="nml-01-lbl" id="out-nml-01"/>
                        <outlet property="subtitleLabel"    destination="sbl-01-lbl" id="out-sbl-01"/>
                        <outlet property="memberLabel"      destination="mbl-01-lbl" id="out-mbl-01"/>
                        <outlet property="ratingLabel"      destination="rtv-01-lbl" id="out-rtv-01"/>
                        <outlet property="ridesLabel"       destination="rdv-01-lbl" id="out-rdv-01"/>
                        <!-- Label outlets inside contact card -->
                        <outlet property="emailValueLabel"  destination="emv-01-lbl" id="out-emv-01"/>
                        <outlet property="phoneValueLabel"  destination="phv-01-lbl" id="out-phv-01"/>
                        <outlet property="homeValueLabel"   destination="hmv-01-lbl" id="out-hmv-01"/>
                    </connections>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="Ief-a0-LHa" userLabel="First Responder" customClass="UIResponder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="1673" y="-58"/>
        </scene>
        <!--Navigation Controller-->
