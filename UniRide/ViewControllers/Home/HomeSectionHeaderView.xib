<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.XIB" version="3.0" toolsVersion="24128" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="24063"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <placeholder placeholderIdentifier="IBFilesOwner" id="-1" userLabel="File's Owner"/>
        <placeholder placeholderIdentifier="IBFirstResponder" id="-2" customClass="UIResponder"/>
        <view contentMode="scaleToFill" id="HSH-Rt-Vw1" customClass="HomeSectionHeaderView" customModule="UniRide" customModuleProvider="target">
            <rect key="frame" x="0.0" y="0.0" width="353" height="36"/>
            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
            <subviews>
                <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Section" textAlignment="natural" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="HSH-Lb-Ttl">
                    <rect key="frame" x="16" y="8" width="100" height="20"/>
                    <fontDescription key="fontDescription" type="system" weight="semibold" pointSize="16"/>
                    <nil key="textColor"/>
                    <nil key="highlightedColor"/>
                </label>
                <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="HSH-Bt-See">
                    <rect key="frame" x="280" y="8" width="57" height="20"/>
                    <state key="normal" title="See All"/>
                    <connections>
                        <action selector="seeAllPressed:" destination="HSH-Rt-Vw1" eventType="touchUpInside" id="HSH-Ac-See"/>
                    </connections>
                </button>
            </subviews>
            <color key="backgroundColor" white="0.0" alpha="0.0" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
            <constraints>
                <constraint firstItem="HSH-Lb-Ttl" firstAttribute="leading" secondItem="HSH-Rt-Vw1" secondAttribute="leading" constant="16" id="HSH-Lb-Lead"/>
                <constraint firstItem="HSH-Lb-Ttl" firstAttribute="centerY" secondItem="HSH-Rt-Vw1" secondAttribute="centerY" id="HSH-Lb-CenY"/>
                <constraint firstItem="HSH-Rt-Vw1" firstAttribute="trailing" secondItem="HSH-Bt-See" secondAttribute="trailing" constant="16" id="HSH-Bt-Trail"/>
                <constraint firstItem="HSH-Bt-See" firstAttribute="centerY" secondItem="HSH-Rt-Vw1" secondAttribute="centerY" id="HSH-Bt-CenY"/>
                <constraint firstItem="HSH-Bt-See" firstAttribute="leading" secondItem="HSH-Lb-Ttl" secondAttribute="trailing" constant="8" relation="greaterThanOrEqual" id="HSH-Bt-Lead"/>
            </constraints>
            <connections>
                <outlet property="seeAllButton" destination="HSH-Bt-See" id="HSH-Out-See"/>
                <outlet property="titleLabel" destination="HSH-Lb-Ttl" id="HSH-Out-Ttl"/>
            </connections>
        </view>
    </objects>
